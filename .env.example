# ==============================================================================
# Freebuff OpenAI-Compatible Cloud API Gateway Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Upstream Freebuff / Codebuff Authentication
# ------------------------------------------------------------------------------
# Your explicitly supplied Freebuff OAuth token for this instance.
# Keychain pointers are tied to their original configuration path; copying a
# pointer file does not migrate login. Authenticate in the target profile or
# supply its token here.
CODEBUFF_API_KEY=your_upstream_codebuff_token_here

# Optional: Account email identifier associated with your Freebuff account
FREEBUFF_USER_EMAIL=user@example.com

# ------------------------------------------------------------------------------
# 2. Gateway Security Protection (Required for non-loopback binds)
# ------------------------------------------------------------------------------
# If set, all API requests to /v1/* require the header:
#   Authorization: Bearer <FREEBUFF_API_KEY>
# Generate one with:  python3 -c "import secrets; print('sk-' + secrets.token_hex(32))"
# The gateway refuses to start on a non-loopback bind (FREEBUFF_API_HOST below)
# unless this key is set. Do not commit the filled-in value.
FREEBUFF_API_KEY=

# ------------------------------------------------------------------------------
# 3. Server Binding & Ports
# ------------------------------------------------------------------------------
# Default to loopback; the gateway enforces authentication for anything else.
FREEBUFF_API_HOST=127.0.0.1
FREEBUFF_API_PORT=8000
PORT=8000

# Managed Sing-box inbounds: bind an IP; use a separate hostname in worker URLs.
# Compose supplies the proxy.internal host mapping inside each container.
# Native execution requires the same stable local host mapping before opting in;
# leave FREEBUFF_PROXY_HOST unset to use the listen IP in native mode.
FREEBUFF_PROXY_LISTEN_IP=127.0.0.1
FREEBUFF_PROXY_HOST=proxy.internal

# ------------------------------------------------------------------------------
# 4. Default Model & Performance Options
# ------------------------------------------------------------------------------
# Use an exact model ID from /v1/models. Prices and eligibility require upstream verification.
FREEBUFF_DEFAULT_MODEL=glm-5.3-flash

# Keystroke Jitter Simulation Mode: "human" (realistic 40-95ms), "fast", "instant"
FREEBUFF_JITTER_MODE=human
FREEBUFF_TURN_TIMEOUT=120
FREEBUFF_BOOT_TIMEOUT=20
# Supervisor terminal view (legacy setting name retained): macOS wraps the
# exact supervisor ps query; Linux sets this supervisor's kernel comm to terminal.
# false disables both. Linux needs neither root nor a PATH wrapper.
FREEBUFF_SUPERVISOR_PS_SHIM=true
# Maximum time waiting for an exclusive worker lease.
FREEBUFF_QUEUE_TIMEOUT=15
FREEBUFF_TAKEOVER_AUTO_CONFIRM=true

# Override the private CLI location (default: <checkout>/.freebuff/private-cli/freebuff).
# FREEBUFF_BIN=/opt/freebuff/private-cli/freebuff

# Auto-confirm model admission prompts and bounded retries (true/false).
FREEBUFF_ADMISSION_AUTO_CONFIRM=true

# Opt-in direct catalog/session and /me lookups from the gateway host. Offline
# by default: the CLI inside each worker already fetches the live catalog
# through its own account proxy, and direct host lookups would expose the
# default account token from a second IP.
# FREEBUFF_LIVE_CATALOG=false

# Workspace selection is restricted to these real filesystem roots.
# Each account gets a separate subdirectory under the worker root by default.
FREEBUFF_WORKER_WORKDIR=/tmp/freebuff-api-worker
# Optional extra operator-approved roots, separated by the OS path separator (: on Unix).
FREEBUFF_ALLOWED_WORKSPACE_ROOTS=

# Hardware UUID/serial/machine-id/hostname probes: auto enables protection on macOS & Linux.
# macOS requires sandbox-exec; Linux virtualizes /etc/machine-id, product_uuid, dmidecode.
# macos/linux enforces that platform; off is for unguarded operation/test fixtures.
FREEBUFF_HARDWARE_PRIVACY=auto

# Workers require the private CLI build described in cli/README.md.
# Default: <checkout>/.freebuff/private-cli/freebuff; custom absolute path:
# FREEBUFF_BIN=/absolute/path/to/private/freebuff
# Keep its adjacent freebuff.privacy.json build receipt when copying it.
# Workers force CODEBUFF_DISABLE_POSTHOG=1 and CODEBUFF_SHIP_LOGS=false.
# Local log.jsonl remains available. The official CLI ignores the PostHog flag.
# For per-account containers use docker-compose.account.yml with a distinct
# Compose project, .env file and FREEBUFF_API_PORT for every account.
