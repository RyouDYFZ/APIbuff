#!/bin/sh
# Freebuff Git privacy shim v1
# Suppress the origin identity probe used by sponsored-project requests.
# Parse arguments rather than matching text in commit messages or pathspecs.
is_origin_query() {
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -C|-c|--git-dir|--work-tree|--namespace|--config-env)
                shift
                [ "$#" -gt 0 ] || return 1
                ;;
            -C?*|-c?*|--git-dir=*|--work-tree=*|--namespace=*|--config-env=*|--exec-path=*|\
            -p|-P|--paginate|--no-pager|--bare|--no-replace-objects|\
            --literal-pathspecs|--glob-pathspecs|--noglob-pathspecs|\
            --icase-pathspecs|--no-optional-locks|--no-lazy-fetch|--no-advice)
                ;;
            --) shift; break ;;
            *) break ;;
        esac
        shift
    done
    [ "$#" -ge 3 ] && [ "$1" = remote ] || return 1
    shift
    case "$1" in -v|--verbose) shift ;; esac
    [ "$1" = get-url ] || return 1
    shift
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --push|--all) shift ;;
            --) shift; break ;;
            *) break ;;
        esac
    done
    [ "$#" -gt 0 ] && [ "$1" = origin ]
}

if is_origin_query "$@"; then
    printf '%s\n' "fatal: No such remote 'origin'" >&2
    exit 128
fi

# Account installations are copies, so inode checks alone cannot recognize
# every guard on PATH. Keep this marker stable across installed versions.
is_privacy_shim() {
    [ "$1" -ef "$0" ] && return 0
    [ -r "$1" ] || return 1
    {
        IFS= read -r git_first_line && [ "$git_first_line" = '#!/bin/sh' ] &&
        IFS= read -r git_marker && [ "$git_marker" = '# Freebuff Git privacy shim v1' ]
    } < "$1"
}

# Keep argv, streams, cwd, PATH and exit status intact. Skip every guard so
# forwarding cannot recurse between account copies or symlinked PATH entries.
git_search_path=${PATH-}
while :; do
    git_search_dir=${git_search_path%%:*}
    git_candidate=${git_search_dir:-.}/git
    if [ -f "$git_candidate" ] && [ -x "$git_candidate" ] &&
       ! is_privacy_shim "$git_candidate"; then
        exec "$git_candidate" "$@"
    fi
    case "$git_search_path" in
        *:*) git_search_path=${git_search_path#*:} ;;
        *) break ;;
    esac
done
printf '%s\n' 'git: executable not found outside privacy shim' >&2
exit 127
